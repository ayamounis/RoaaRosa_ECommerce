# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js and nest.js build outputs
.next/
**/.next/
out/
/out/
dist/
**/dist/
build/
/build
.turbo/

# misc
.DS_Store
*.pem
.agents/
**/.agents/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!**/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# scratch scripts and local dumps
/*.py
/*.html
/*.db
/*.txt
/*.json
/*.png
/*.jpg
/*.bat
/chrome_profile/
/download_*.js
/extract_*.js
/find_*.js
/inspect_*.js
/parse_*.js
/retry_*.js
/search_*.js
/scripts/
